{
  "name": "pi-drill",
  "version": "1.0.0",
  "description": "Reverse mentor mode for the Pi coding agent: the model reviews and guides, you write the code.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": [
      "./commands/*.md"
    ]
  },
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "node bench/run.ts",
    "check": "npm run fmt:check && npm run lint && npm run types && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
